# Copy to .env and fill in. Never commit .env.

# --- OANDA (v20 REST) ---
# practice = fxpractice (paper money). live is refused unless ZIA_LIVE=true AND confirmed on the CLI.
OANDA_ENV=practice
OANDA_API_KEY=replace-with-your-practice-token
OANDA_ACCOUNT_ID=000-000-0000000-000

# --- Anthropic (signal reviewer) ---
ANTHROPIC_API_KEY=replace-with-your-anthropic-key
ZIA_MODEL=claude-opus-5-5
ZIA_LLM_ENABLED=true

# --- Live trading switch (keep false) ---
ZIA_LIVE=false

# --- Market ---
ZIA_INSTRUMENTS=EUR_USD,GBP_USD,USD_JPY
ZIA_TIMEFRAME=H1

# --- Risk (development defaults, not recommendations) ---
ZIA_RISK_PER_TRADE_PCT=1.0
ZIA_MAX_DAILY_LOSS_PCT=3.0
ZIA_MAX_DRAWDOWN_PCT=10.0
ZIA_MAX_OPEN_TRADES=3
ZIA_MAX_SPREAD_PIPS=3.0

# --- Runtime ---
ZIA_DB_PATH=zia.db
ZIA_LOG_LEVEL=INFO
